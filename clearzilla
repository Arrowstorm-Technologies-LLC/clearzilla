readonly ZILLA_H=${#ZILLA_SPRITE[@]}
readonly ZILLA_W=39

declare -a ZILLA_MIRRORED=()
for _line in "${ZILLA_SPRITE[@]}"; do
  ZILLA_MIRRORED+=("$(printf '%s' "$_line" | rev)")
done
unset _line
readonly -a ZILLA_MIRRORED

SPEED=1
FAST=0
FORCE_WHITE=0

usage() {
  cat <<EOF
${BOLD}clearzilla${RESET} — Godzilla fire-breaths your terminal clean

${BOLD}Usage:${RESET}
  clearzilla              Stomp in and clear the screen
  clearzilla ${YELLOW}-s${RESET} ${DIM}<n>${RESET}            Speed multiplier (default: 1, higher = faster)
  clearzilla ${YELLOW}-f${RESET}                   Skip animation, clear immediately
  clearzilla ${YELLOW}-t${RESET}                   Draw Godzilla in plain white, ignoring the terminal's theme colors
  clearzilla ${YELLOW}-h${RESET}                   Show this help
  clearzilla ${YELLOW}-v${RESET}                   Show version

Godzilla sweeps the visible terminal band by band until clear.
EOF
}

# ── terminal helpers ──────────────────────────────────────────────────────────
get_dims() {
  local size rows cols
  rows=0 cols=0
  size=$(stty size 2>/dev/null || true)
  if [[ -n "$size" ]]; then
    rows=${size%% *}
    cols=${size##* }
  fi
  (( rows < 1 )) && rows=${LINES:-$(tput lines 2>/dev/null || echo 24)}
  (( cols < 1 )) && cols=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}
  (( rows < 1 )) && rows=24
  (( cols < 1 )) && cols=80
  (( rows > 128 )) && rows=128
  (( cols > 512 )) && cols=512
  TERM_ROWS=$rows
  TERM_COLS=$cols
}

band_height() {
  local band_row=$1
  local h=$(( TERM_ROWS - band_row + 1 ))
  (( h > ZILLA_H )) && h=$ZILLA_H
  (( h < 1 )) && h=1
  echo "$h"
}

frame_delay() {
  local extra=${1:-0}
  local ms=$(( (40 + extra) / SPEED ))
  (( ms < 3 )) && ms=3
  sleep "0.$(printf '%03d' "$ms")"
}

walk_stride() {
  local stride=$SPEED
  (( stride < 2 )) && stride=2
  echo "$stride"
}

move_to() {
  printf '\033[%d;%dH' "$1" "$2"
}

draw_sprite() {
  local -n lines=$1
  local row=$2 col=$3
  local h=${4:-$ZILLA_H}
  local i=0
  for line in "${lines[@]}"; do
    (( i >= h )) && break
    move_to $((row + i)) "$col"
    printf '%s' "$line"
    ((i++)) || true
  done
}

erase_sprite() {
  local row=$1 col=$2
  local h=${3:-$ZILLA_H}
  local at_edge=${4:-0}
  local blank
  blank=$(printf '%*s' "$ZILLA_W" '')
  local i
  for ((i = 0; i < h; i++)); do
    move_to $((row + i)) "$col"
    printf '%s' "$blank"
    # \033[K (erase to end of line) reaches the terminal's true last
    # column without ever placing a character glyph there -- the sprite
    # itself stays capped one column short (see max_x). Only fire this
    # when the sprite is actually at the sweep's far edge (at_edge); doing
    # it on every frame erases everything past the sprite immediately,
    # well ahead of Godzilla actually walking there.
    (( at_edge )) && printf '\033[K' || true
  done
}

clear_screen() {
  printf '\033[3J\033[2J\033[H'
  run_post_clear_hook
}

# Optional extensibility point: if CLEARZILLA_POST_CLEAR names an exported
# function or a command on PATH, run it right after the screen clears. Lets
# a shell rc reprint a banner/prompt/MOTD after clearzilla the same way it
# would after plain `clear` -- clearzilla has no opinion on what that is.
# A failing hook must never take clearzilla down with it under set -e, hence
# the `|| true` rather than relying on the if-condition's own -e exemption.
run_post_clear_hook() {
  local hook=${CLEARZILLA_POST_CLEAR:-}
  if [[ -n "$hook" ]] && command -v "$hook" >/dev/null 2>&1; then
    "$hook" || true
  fi
}

# ── animation (band sweep) ────────────────────────────────────────────────────
# Godzilla is ZILLA_H lines tall. Each horizontal pass clears one full band
# before stepping down to the next band.
animate() {
  get_dims

  local x stride max_x band_row band_h band_num=0

  stride=$(walk_stride)
  # Deliberately never reach TERM_COLS: a band that includes the terminal's
  # last row would then place a sprite glyph in its absolute bottom-right
  # cell. Disabling autowrap (DECAWM) around the sweep did NOT prevent the
  # resulting misalignment, which means it isn't a deferred-wrap/scroll
  # issue -- something about placing a character glyph there at all is
  # what triggers it. One column short of full-width sprite coverage is
  # invisible (erase_sprite still wipes that column via \033[K, a control
  # sequence rather than a glyph write, so nothing lingers there either).
  max_x=$(( TERM_COLS - ZILLA_W ))
  (( max_x < 1 )) && max_x=1

  printf '%s' "$HIDE_CURSOR"
  (( FORCE_WHITE )) && printf '\033[97m'

  for ((band_row = 1; band_row <= TERM_ROWS; band_row += ZILLA_H)); do
    band_h=$(band_height "$band_row")

    if (( band_num % 2 == 0 )); then
      x=1
      while true; do
        draw_sprite ZILLA_SPRITE "$band_row" "$x" "$band_h"
        frame_delay
        erase_sprite "$band_row" "$x" "$band_h" "$(( x == max_x ))"
        (( x >= max_x )) && break || true
        (( x += stride ))
        (( x > max_x )) && x=$max_x || true
      done
    else
      x=$max_x
      while true; do
        draw_sprite ZILLA_MIRRORED "$band_row" "$x" "$band_h"
        frame_delay
        erase_sprite "$band_row" "$x" "$band_h" "$(( x == max_x ))"
        (( x <= 1 )) && break || true
        (( x -= stride ))
        (( x < 1 )) && x=1 || true
      done
    fi

    (( band_num++ )) || true
  done

  (( FORCE_WHITE )) && printf '%s' "$RESET"
  printf '%s' "$SHOW_CURSOR"
  clear_screen
}

# ── main ──────────────────────────────────────────────────────────────────────
while getopts 's:fthv' opt; do
  case "$opt" in
    s)
      SPEED=$OPTARG
      if ! [[ "$SPEED" =~ ^[0-9]+$ ]] || (( SPEED < 1 )); then
        echo "clearzilla: speed must be a positive integer" >&2
        exit 1
      fi
      ;;
    f) FAST=1 ;;
    t) FORCE_WHITE=1 ;;
    h)
      usage
      exit 0
      ;;
    v)
      echo "clearzilla $VERSION"
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done

if (( FAST )) || [[ ! -t 1 ]]; then
  clear_screen
  exit 0
fi

# Need UTF-8 for the block-art sprite
if [[ -z "${LANG:-}" ]] || [[ ! "${LANG}" =~ [Uu][Tt][Ff]-?8 ]]; then
  export LANG="${LANG:-en_US.UTF-8}"
fi

animate
