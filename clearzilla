  YELLOW="\033[1;33m"
  RED="\033[1;31m"
  RESET="\033[0m"
  HIDE_CURSOR=$'\033[?25l'
  SHOW_CURSOR=$'\033[?25h'
else
  BOLD="" DIM="" GREEN="" YELLOW="" RED="" RESET=""
  HIDE_CURSOR="" SHOW_CURSOR=""
fi

